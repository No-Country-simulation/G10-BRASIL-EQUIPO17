# Exemplo de configuracao — NAO inclui credenciais reais.
MEDIFLOW_ENV=development
# Configuracoes abaixo serao usadas no Dia 4/5, nao no Dia 3.
OCI_CONFIG_FILE=
OCI_CONFIG_PROFILE=DEFAULT
OCI_NAMESPACE=
OCI_BUCKET=
LLM_PROVIDER=
LLM_API_KEY=

# Upload sem autenticação SOMENTE em desenvolvimento local. Por padrão: desativado.
MEDIFLOW_ENABLE_LOCAL_UPLOADS=false
