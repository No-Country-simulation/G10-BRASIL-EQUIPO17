            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Solicitacao"
        },
        "data_admissao": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
