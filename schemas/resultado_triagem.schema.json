          "title": "Destino Principal",
          "type": "string"
        },
        "requer_revisao_humana": {
          "title": "Requer Revisao Humana",
          "type": "boolean"
        },
        "regra_principal": {
          "enum": [
            "R001",
            "R002",
            "R003",
            "R004",
            "R005",
            "R006",
            "R900"
          ],
          "title": "Regra Principal",
          "type": "string"
        },
        "regras_disparadas": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Regras Disparadas",
          "type": "array"
        },
        "justificativa": {
          "minLength": 1,
          "title": "Justificativa",
          "type": "string"
        },
        "versao_regras": {
          "const": "0.1",
          "default": "0.1",
          "title": "Versao Regras",
          "type": "string"
