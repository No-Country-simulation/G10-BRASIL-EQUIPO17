      "title": "DecisaoRoteamento",
      "type": "object"
    },
    "EntradaProcessada": {
      "additionalProperties": false,
      "properties": {
        "tipo_entrada": {
          "enum": [
            "texto",
            "pdf",
            "png",
            "jpeg"
