      "const": "0.1",
      "default": "0.1",
      "title": "Contrato Versao",
      "type": "string"
    },
    "documento_id": {
      "title": "Documento Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "recebido",
        "processando",
        "processado",
        "aguardando_auditoria",
        "falha"
      ],
      "title": "Status",
      "type": "string"
    },
    "entrada": {
      "$ref": "#/$defs/EntradaProcessada"
    },
    "classificacao": {
      "$ref": "#/$defs/Classificacao"
