        },
        "resumo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resumo"
        },
        "descricao_documento": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Descricao Documento"
        }
      },
      "title": "DadosExtraidos",
      "type": "object"
    },
    "DecisaoRoteamento": {
      "additionalProperties": false,
      "properties": {
        "destino_principal": {
          "enum": [
            "fila_prioritaria_avaliacao_humana",
            "auditoria_humana",
            "auditoria_autorizacoes",
            "fila_farmacia_documental",
            "prontuario_documental",
            "fila_erros_tecnicos"
