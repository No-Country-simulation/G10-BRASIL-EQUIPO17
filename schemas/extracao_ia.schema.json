          "type": "boolean"
        },
        "transcricao_marcador_urgencia": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transcricao Marcador Urgencia"
        }
      },
      "title": "SinaisDocumentais",
      "type": "object"
    }
