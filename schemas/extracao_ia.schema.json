            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Solicitacao"
        },
        "data_admissao": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Admissao"
        },
        "data_alta": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Alta"
        },
        "afastamento_periodo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Afastamento Periodo"
        },
        "resumo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resumo"
        },
        "descricao_documento": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Descricao Documento"
        }
      },
      "title": "DadosExtraidos",
      "type": "object"
    },
    "Evidencia": {
      "additionalProperties": false,
      "properties": {
        "campo": {
          "title": "Campo",
          "type": "string"
        },
        "trecho_documento": {
          "minLength": 1,
          "title": "Trecho Documento",
          "type": "string"
        },
        "pagina": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pagina"
        },
        "origem": {
          "const": "documento",
          "default": "documento",
          "title": "Origem",
          "type": "string"
        }
      },
      "required": [
        "campo",
        "trecho_documento"
      ],
      "title": "Evidencia",
      "type": "object"
    },
