  "additionalProperties": false,
  "properties": {
    "contrato_versao": {
      "const": "0.1",
      "default": "0.1",
      "title": "Contrato Versao",
      "type": "string"
    },
    "documento_id": {
      "title": "Documento Id",
      "type": "string"
    },
    "tipo_documento": {
      "enum": [
        "receituario",
        "laudo_laboratorial",
        "laudo_imagem",
        "solicitacao_exame",
        "relatorio_alta",
        "atestado",
        "outro_desconhecido"
      ],
      "title": "Tipo Documento",
      "type": "string"
    },
    "especialidade_texto": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Especialidade Texto"
    },
    "dados_extraidos": {
      "$ref": "#/$defs/DadosExtraidos"
    },
    "evidencias": {
      "items": {
        "$ref": "#/$defs/Evidencia"
      },
      "title": "Evidencias",
      "type": "array"
    },
    "sinais_documentais": {
      "$ref": "#/$defs/SinaisDocumentais"
    }
